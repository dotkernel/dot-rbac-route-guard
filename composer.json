{
    "name": "dotkernel/dot-rbac-route-guard",
    "type": "library",
    "description": "Dotkernel RBAC route guard component for Mezzio, for any PSR-11 container",
    "support": {
        "docs": "https://docs.dotkernel.org/dot-rbac-route-guard/",
        "issues": "https://github.com/dotkernel/dot-rbac-route-guard/issues"
    },
    "license": "MIT",
    "homepage": "https://github.com/dotkernel/dot-rbac-route-guard",
    "keywords": [
        "authentication",
        "authorization",
        "laminas",
        "mezzio",
        "route",
        "rbac-guard",
        "rbac"
    ],
    "authors": [
        {
            "name": "Dotkernel Team",
            "email": "team@dotkernel.com"
        }
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "dotkernel/dot-authentication": "^2.3.4 || ^3.0",
        "dotkernel/dot-authorization": "^3.6 || ^4.0",
        "dotkernel/dot-event": "^4.2 || ^5.0",
        "dotkernel/dot-rbac": "^4.0 || ^5.0",
        "laminas/laminas-diactoros": "^3.3.0",
        "laminas/laminas-eventmanager": "^3.16",
        "laminas/laminas-stdlib": "^3.19",
        "mezzio/mezzio-router": "^3.17",
        "mezzio/mezzio-template": "^2.10.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.5.22"
    },
    "autoload": {
        "psr-4": {
            "Dot\\Rbac\\Route\\Guard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DotTest\\Rbac\\Route\\Guard\\": "test/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "conflict": {
        "dotkernel/dot-rbac-guard": "*"
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test",
            "@static-analysis"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "static-analysis": "phpstan analyse --memory-limit 1G",
        "test": "phpunit --colors=always"
    }
}
